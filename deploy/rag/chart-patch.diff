diff -ruN '--exclude=charts' rag/deploy/helm/nvidia-blueprint-rag/templates/elasticsearch.yaml deploy/rag/chart/templates/elasticsearch.yaml
--- rag/deploy/helm/nvidia-blueprint-rag/templates/elasticsearch.yaml	1970-01-01 04:00:00.000000000 +0400
+++ deploy/rag/chart/templates/elasticsearch.yaml	2026-11-20 11:25:16.705134807 +0400
@@ -0,0 +1,118 @@
+{{- /*
+PATCH(nvaie): NEW FILE. Plain single-node Elasticsearch (Deployment + Service + PVC).
+Replaces the eck-elasticsearch subchart, which needs the ECK operator and its cluster-wide
+CRDs. Same settings NVIDIA uses in its Docker Compose deployment of this blueprint
+(single node, security off, no mmap). No CRDs, no operator, no fixed UID: the image runs
+under OpenShift restricted-v2 with a random UID (group 0) and the PVC is made writable
+through the pod fsGroup. Off by default (upstream behaviour unchanged).
+*/ -}}
+{{- if .Values.elasticsearch.enabled }}
+{{- $es := .Values.elasticsearch }}
+{{- $name := printf "%s-elasticsearch" .Release.Name }}
+{{- if $es.persistence.enabled }}
+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: {{ $name }}-data
+  labels:
+    {{- include "nvidia-blueprint-rag.labels" . | nindent 4 }}
+    app.kubernetes.io/component: elasticsearch
+spec:
+  accessModes: [ReadWriteOnce]
+  {{- with $es.persistence.storageClass }}
+  storageClassName: {{ . }}
+  {{- end }}
+  resources:
+    requests:
+      storage: {{ $es.persistence.size }}
+---
+{{- end }}
+apiVersion: v1
+kind: Service
+metadata:
+  name: {{ $name }}
+  labels:
+    {{- include "nvidia-blueprint-rag.labels" . | nindent 4 }}
+    app.kubernetes.io/component: elasticsearch
+spec:
+  type: ClusterIP
+  selector:
+    app: {{ $name }}
+  ports:
+    - name: http
+      port: 9200
+      targetPort: 9200
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {{ $name }}
+  labels:
+    {{- include "nvidia-blueprint-rag.labels" . | nindent 4 }}
+    app.kubernetes.io/component: elasticsearch
+spec:
+  replicas: 1
+  strategy:
+    type: Recreate        # ReadWriteOnce volume: the old pod must stop before the new one starts
+  selector:
+    matchLabels:
+      app: {{ $name }}
+  template:
+    metadata:
+      labels:
+        app: {{ $name }}
+        {{- if .Values.kueue.queueName }}
+        kueue.x-k8s.io/queue-name: {{ .Values.kueue.queueName | quote }}
+        {{- end }}
+    spec:
+      automountServiceAccountToken: false
+      {{- with $es.podSecurityContext }}
+      securityContext:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      {{- with $es.nodeSelector }}
+      nodeSelector:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      containers:
+        - name: elasticsearch
+          image: {{ $es.image | quote }}
+          imagePullPolicy: IfNotPresent
+          {{- with $es.containerSecurityContext }}
+          securityContext:
+            {{- toYaml . | nindent 12 }}
+          {{- end }}
+          ports:
+            - name: http
+              containerPort: 9200
+          env:
+            - {name: discovery.type, value: single-node}
+            - {name: xpack.security.enabled, value: "false"}
+            - {name: xpack.security.http.ssl.enabled, value: "false"}
+            - {name: xpack.security.transport.ssl.enabled, value: "false"}
+            - {name: node.store.allow_mmap, value: "false"}   # no vm.max_map_count change needed on the node
+            - {name: ES_JAVA_OPTS, value: {{ $es.javaOpts | quote }}}
+          resources:
+            {{- toYaml $es.resources | nindent 12 }}
+          readinessProbe:
+            exec:
+              command:
+                - bash
+                - -c
+                - curl -s http://localhost:9200/_cluster/health | grep -q '"status":"green"\|"status":"yellow"'
+            initialDelaySeconds: 20
+            periodSeconds: 10
+            timeoutSeconds: 5
+            failureThreshold: 30
+          volumeMounts:
+            - name: data
+              mountPath: /usr/share/elasticsearch/data
+      volumes:
+        - name: data
+          {{- if $es.persistence.enabled }}
+          persistentVolumeClaim:
+            claimName: {{ $name }}-data
+          {{- else }}
+          emptyDir: {}
+          {{- end }}
+{{- end }}

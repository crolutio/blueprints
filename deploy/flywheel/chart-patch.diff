diff -ruN '--exclude=charts' data-flywheel/deploy/helm/data-flywheel/templates/nemo-gateway.yaml deploy/flywheel/chart/templates/nemo-gateway.yaml
--- data-flywheel/deploy/helm/data-flywheel/templates/nemo-gateway.yaml	1970-01-01 04:00:00.000000000 +0400
+++ deploy/flywheel/chart/templates/nemo-gateway.yaml	2026-11-20 11:25:40.169824786 +0400
@@ -0,0 +1,114 @@
+{{- /*
+PATCH(nvaie): NEW FILE. In-cluster path router for the NeMo APIs.
+The flywheel server sends every NeMo call (customizer, evaluator, deployment-management,
+entity-store) to ONE base URL (nmp_config.nemo_base_url). Upstream solves this with an
+Ingress on fake hosts (nemo.test). This CPU-only nginx pod reproduces the same path map
+(copied from the upstream NeMo 25.8 Ingress) inside the namespace, so nothing is exposed
+outside the cluster. No GPU.
+*/ -}}
+{{- if .Values.nemoGateway.enabled }}
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: nemo-gateway-config
+  namespace: {{ .Release.Namespace }}
+data:
+  nginx.conf: |
+    worker_processes 1;
+    pid /tmp/nginx.pid;
+    error_log /dev/stderr warn;
+    events { worker_connections 256; }
+    http {
+      access_log /dev/stdout;
+      client_body_temp_path /tmp/client_body;
+      proxy_temp_path       /tmp/proxy;
+      fastcgi_temp_path     /tmp/fastcgi;
+      uwsgi_temp_path       /tmp/uwsgi;
+      scgi_temp_path        /tmp/scgi;
+      client_max_body_size 0;
+      proxy_read_timeout 600s;
+      proxy_send_timeout 600s;
+      proxy_http_version 1.1;
+      proxy_set_header Host $host;
+      server {
+        listen 8080;
+        location = /healthz          { return 200 "ok\n"; }
+        location /v1/namespaces      { proxy_pass http://nemo-entity-store:8000; }
+        location /v1/projects        { proxy_pass http://nemo-entity-store:8000; }
+        location /v1/datasets        { proxy_pass http://nemo-entity-store:8000; }
+        location /v1/repos           { proxy_pass http://nemo-entity-store:8000; }
+        location /v1/models          { proxy_pass http://nemo-entity-store:8000; }
+        {{- /* No route when Customizer is disabled: nginx refuses to start if an upstream host does not resolve */}}
+        {{- $nmp := index .Values "nemo-microservices-helm-chart" | default dict }}
+        {{- $cust := $nmp.customizer | default dict }}
+        {{- if ne (toString $cust.enabled) "false" }}
+        location /v1/customization   { proxy_pass http://nemo-customizer:8000; }
+        {{- end }}
+        location /v1/evaluation      { proxy_pass http://nemo-evaluator:7331; }
+        location /v1/deployment      { proxy_pass http://nemo-deployment-management:8000; }
+      }
+    }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: nemo-gateway
+  namespace: {{ .Release.Namespace }}
+  labels:
+    app: nemo-gateway
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: nemo-gateway
+  template:
+    metadata:
+      labels:
+        app: nemo-gateway
+        {{- include "df.podLabels" . | nindent 8 }}
+      annotations:
+        checksum/config: {{ .Values.nemoGateway | toJson | sha256sum }}
+    spec:
+      automountServiceAccountToken: false
+      {{- include "df.podSpecExtras" . | nindent 6 }}
+      containers:
+        - name: nginx
+          image: {{ .Values.nemoGateway.image | quote }}
+          imagePullPolicy: IfNotPresent
+          {{- include "df.containerSecurityContext" . | nindent 10 }}
+          command: ["nginx", "-g", "daemon off;", "-c", "/etc/nemo-gateway/nginx.conf"]
+          ports:
+            - containerPort: 8080
+          readinessProbe:
+            httpGet:
+              path: /healthz
+              port: 8080
+            periodSeconds: 10
+          resources:
+            {{- toYaml .Values.nemoGateway.resources | nindent 12 }}
+          volumeMounts:
+            - name: config
+              mountPath: /etc/nemo-gateway
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: config
+          configMap:
+            name: nemo-gateway-config
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: nemo-gateway
+  namespace: {{ .Release.Namespace }}
+spec:
+  type: ClusterIP
+  selector:
+    app: nemo-gateway
+  ports:
+    - name: http
+      port: 80
+      targetPort: 8080
+{{- end }}
